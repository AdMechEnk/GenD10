{{!-- Actor Equipment Partial --}}
<div class="actor-equipment-section">
  <h3>Equipment</h3>
  <div class="equipment-grid">
    <div class="equipment-item">
      <h4>Weapons</h4>
      <textarea name="system.weapons" placeholder="Weapons">{{system.weapons}}</textarea>
    </div>
    <div class="equipment-item">
      <h4>Armor</h4>
      <textarea name="system.armor" placeholder="Armor">{{system.armor}}</textarea>
    </div>
    <div class="equipment-item">
      <h4>General Items</h4>
      <textarea name="system.generalItems" placeholder="General Items">{{system.generalItems}}</textarea>
    </div>
  </div>
</div>
