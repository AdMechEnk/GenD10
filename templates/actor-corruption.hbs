{{!-- Actor Corruption Partial --}}
<div class="actor-corruption-section">
  <h3>Corruption & Insanity</h3>
  <div class="corruption-grid">
    <div class="corruption-item">
      <h4>Corruption</h4>
      <textarea name="system.corruption" placeholder="Corruption">{{system.corruption}}</textarea>
    </div>
    <div class="corruption-item">
      <h4>Insanity</h4>
      <textarea name="system.insanity" placeholder="Insanity">{{system.insanity}}</textarea>
    </div>
  </div>
  
  <h3>Traits & Feats</h3>
  <div class="traits-feats-grid">
    <textarea name="system.traitsFeats" placeholder="Traits and Feats">{{system.traitsFeats}}</textarea>
  </div>
</div>
